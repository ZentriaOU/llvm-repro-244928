{
  description = "Reproducer for llvm/llvm-project#244928";

  # The outputs in this repository were made with this nixpkgs (LLVM 23.1.3).
  inputs.nixpkgs.url = "github:NixOS/nixpkgs/0bb2eedc20e4739f29e8045034f2828ad7054f8f";

  outputs =
    { self, nixpkgs }:
    let
      systems = [
        "aarch64-darwin"
        "x86_64-darwin"
        "aarch64-linux"
        "x86_64-linux"
      ];
      forAll = f: nixpkgs.lib.genAttrs systems (system: f nixpkgs.legacyPackages.${system});

      perSystem =
        pkgs:
        let
          llvm = pkgs.llvmPackages_23;

          # The change from the PR, with paths relative to llvm/.
          llvmPatched = llvm.overrideScope (
            _: prev: {
              libllvm = prev.libllvm.overrideAttrs (old: {
                patches = old.patches ++ [ ./llvm-instr-ref-ldv-stable-sort.patch ];
              });
            }
          );

          ring = pkgs.fetchurl {
            url = "https://static.crates.io/crates/ring/ring-0.17.14.crate";
            hash = "sha256-pGiebCKU2B6I3GJhx2i2O8T824Ur5tE1JJixFPYTg7c=";
          };

          # ring's curve25519.c as optimised IR. ring needs no libc headers with
          # RING_CORE_NOSTDLIBINC. prefix_symbols.h is generated by ring's build
          # script and only renames symbols, so it is left empty here.
          ir = pkgs.runCommand "curve25519.ll" { } ''
            tar -xzf ${ring}
            cd ring-0.17.14
            mkdir -p gen/ring_core_generated
            touch gen/ring_core_generated/prefix_symbols.h
            ${llvm.clang-unwrapped}/bin/clang \
              --target=x86_64-unknown-linux-musl -O3 -g -gdwarf-5 -fPIC \
              -ffunction-sections -fdata-sections -fvisibility=hidden -std=c1x \
              -DNDEBUG -DRING_CORE_NOSTDLIBINC=1 -nostdlibinc \
              -ffile-prefix-map=$PWD=. \
              -ffile-prefix-map=${llvm.clang-unwrapped.lib}=/clang \
              -I include -I gen \
              -S -emit-llvm crypto/curve25519/curve25519.c -o $out
          '';

          llc = llvm': "${llvm'.llvm}/bin/llc -O3 -relocation-model=pic";

          # The input is copied so the output names it without its store path.
          mir =
            name: llvm': input: file:
            pkgs.runCommand name { } ''
              cp ${input} ${file}
              ${llc llvm'} ${file} -stop-after=livedebugvalues -o $out
            '';

          # llvm-reduce keeps a change if llc with std::sort and llc with
          # std::stable_sort still disagree.
          interesting = pkgs.writeShellScript "interesting" ''
            d=$(mktemp -d)
            trap 'rm -rf "$d"' EXIT
            ${llc llvm} "$1" -stop-after=livedebugvalues -o "$d/a.mir" 2>/dev/null || exit 1
            ${llc llvmPatched} "$1" -stop-after=livedebugvalues -o "$d/b.mir" 2>/dev/null || exit 1
            ! cmp -s "$d/a.mir" "$d/b.mir"
          '';
        in
        {
          inherit ir;
          default = mir "out.mir" llvm ./repro.ll "repro.ll";
          mir-patched = mir "out-patched.mir" llvmPatched ./repro.ll "repro.ll";
          full-mir = mir "full.mir" llvm ir "curve25519.ll";
          full-mir-patched = mir "full-patched.mir" llvmPatched ir "curve25519.ll";

          # Writes reduced.ll to the current directory.
          reduce = pkgs.writeShellScriptBin "reduce" ''
            exec ${llvm.llvm}/bin/llvm-reduce --test=${interesting} -o reduced.ll ${ir}
          '';
        };
    in
    {
      packages = forAll perSystem;
    };
}
