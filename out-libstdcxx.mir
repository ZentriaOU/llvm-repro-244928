  @k25519Precomp = external constant [32 x [8 x [3 x [32 x i8]]]]
  
  define fastcc void @table_select(i64 %0) #0 !dbg !4 {
    %2 = getelementptr [768 x i8], ptr @k25519Precomp, i64 %0
