    %17 = trunc i64 %16 to i8
    %18 = getelementptr i8, ptr %2, i64 192
      #dbg_value(ptr %18, !20, !DIExpression(), !7)
      #dbg_value(ptr %18, !15, !DIExpression(), !7)
